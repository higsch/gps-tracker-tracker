# Copy to .env and fill in. Real environment variables always win over this file.

# Your Fressnapf *shop* account (the one you log into tracker.fressnapf.de with).
# Only needed for `gtt login`; polling uses the device token it stores.
# Leave blank to be prompted interactively instead of keeping the password on disk.
FRESSNAPF_EMAIL=
FRESSNAPF_PASSWORD=

# Where the position archive lives.
GTT_DB_PATH=./data/tracker.duckdb

# Where `gtt login` stores the (serial, device token) pairs. Written with mode 0600.
GTT_CREDENTIALS_PATH=~/.config/gps-tracker-tracker/credentials.json

# Seconds between polls in `gtt watch`. The tracker reports every ~10 minutes
# while still and every ~20s in live mode, so 30 is the useful floor.
GTT_POLL_INTERVAL=300

# Keep the tracker in live mode (a fix every ~20s) by requesting it on the first
# poll and renewing it before each 10-minute grant runs out. Live mode costs
# battery: about 10 hours of continuous use per charge.
GTT_LIVE_TRACKING=1

# Daily hours, as UTC clock times, during which live mode is kept running.
# Set both empty for around the clock; an end before the start wraps midnight.
GTT_LIVE_FROM=15:00
GTT_LIVE_UNTIL=22:00

# On every poll, also fetch the API's position history (up to the last 24 h,
# every fix, unsampled) and insert what the archive is missing. Closes the gaps a
# 30 s poller leaves during 20 s live mode and heals outages of up to a day.
GTT_BACKFILL=1

# HTTP timeout per API request, in seconds.
GTT_REQUEST_TIMEOUT=10

# Locale for the sign-in email.
GTT_LOCALE=de

# DEBUG | INFO | WARNING | ERROR
GTT_LOG_LEVEL=INFO
